; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pixel Blast"
config/description="A pixel-art block puzzle for Android and iOS."
config/version="0.1.0"
run/main_scene="res://scenes/splash.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.09, 0.071, 0.059, 1)
boot_splash/image="res://ui/boot_splash.png"
config/icon="res://ui/icon.png"

[autoload]

App="*res://scripts/app.gd"
Scores="*res://scripts/scores.gd"
Difficulty="*res://scripts/difficulty.gd"
Themes="*res://scripts/themes.gd"
Audio="*res://scripts/audio.gd"
Modes="*res://scripts/modes.gd"
GameServices="*res://scripts/game_services.gd"
Progress="*res://scripts/progress.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://ui/theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
